{
  "name": "@whiteflow/merchant-mcp",
  "version": "0.3.0",
  "private": true,
  "description": "Whiteflow Merchant MCP: payment links, customers, invoices, payments and collection summaries from an MCP client (stdio). Testnet or a labelled local sandbox.",
  "type": "module",
  "bin": {
    "whiteflow-mcp": "./src/index.ts",
    "whiteflow-sandbox": "./src/sandbox/cli.ts"
  },
  "scripts": {
    "start": "node src/index.ts",
    "sandbox": "node src/sandbox/cli.ts",
    "test": "node --test test/",
    "typecheck": "tsc --noEmit",
    "manifest": "node scripts/manifest.mjs",
    "build": "node scripts/build.mjs",
    "pack": "node scripts/pack.mjs",
    "npm-package": "node scripts/npm-package.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@anthropic-ai/mcpb": {
      "zod": "$zod"
    }
  }
}
