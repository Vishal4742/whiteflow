# Copy the names into .env and fill in the values. Never commit .env (CON-7). Never print a value.
# Whitechain Sepolia (1874)
WHITECHAIN_RPC_URL=https://rpc.ankr.com/whitechain_testnet
DEPLOYER_PRIVATE_KEY=     # deployer + team wallet + compliance admin; funds demo wallets (CON-8)
RELAYER_PRIVATE_KEY=      # relayer hot wallet, apps/relayer only, keep <= 0.5 WBT
PAYER_PRIVATE_KEY=        # G1 scripted payer: holds USDT, never WBT (proves the payer pays no gas)
DEMO_MERCHANT_PRIVATE_KEY=     # seed-script demo wallets (CON-8): merchant, investors A and B, debtor
DEMO_INVESTOR_A_PRIVATE_KEY=
DEMO_INVESTOR_B_PRIVATE_KEY=
DEMO_DEBTOR_PRIVATE_KEY=
COLLECTOR1_PRIVATE_KEY=   # faucet collectors 1-3, swept to the team wallet
COLLECTOR2_PRIVATE_KEY=
COLLECTOR3_PRIVATE_KEY=
# Arkiv Rabdi testnet (7794095)
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_PRIVATE_KEY=        # Arkiv writer, apps/web server only
ARKIV_ACCESS_KEY=         # hub.arkiv.network/access-keys (goes in the RPC URL path; origin-restricted, not a secret); keyless endpoint times out
# Neon Postgres (apps/web + apps/relayer, Phase 2)
DATABASE_URL=
# Shared memory (tools/supermemory.sh, tools/claude.sh)
SUPERMEMORY_API_KEY=
SUPERMEMORY_CC_API_KEY=
OPENAI_API_KEY=           # DeepSeek, OpenAI-compatible
OPENAI_BASE_URL=
OPENAI_MODEL=
VOUCHER_HASH_SECRET=      # HMAC key for Arkiv voucher code hashes (apps/web server only)
RELAY_API_SECRET=         # shared secret: apps/web server -> relayer /relay header (both server envs only)
CRON_SECRET=              # protects the webhook-retry / keeper cron routes (apps/web server only)
# Public IDs (apps/web, inlined into the browser bundle; not secrets): Pay with your wallet through Privy (batch 046)
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=   # optional: our own WalletConnect project for phone wallets
# The web app (apps/web server only)
PUBLIC_ORIGIN=            # this site's origin, e.g. https://whiteflow.org: sign-in checks it and links are built on it
PRIVY_VERIFICATION_KEY=   # Privy's verification key (PEM, "\n" escapes are fine), checks sign-in tokens
MERCHANT_PAY_ADDRESS=     # the MerchantPay contract on Whitechain testnet; payments stay off until it and RELAYER_URL are set
RELAYER_URL=              # the relayer's base URL (apps/relayer)
MERCHANT_ADDRESS=         # the demo shop behind "Try a checkout": its wallet,
SHOP_API_KEY=             # its gateway API key,
MERCHANT_NAME=            # and its name at checkout (default Bandra Beans)
DEMO_LINK_SLUG=           # optional: a payment link and a payment page the landing page shows as working examples
DEMO_PAGE_SLUG=
